# ============================================================================
# KAURAX — environment template
#
#   cp .env.example .env
#
# NEVER commit .env. NEVER put a real private key in this file.
# The keys below are the well-known, publicly documented Anvil test keys.
# They are deliberately public, hold no value, and MUST NOT be used anywhere
# other than a local devnet.
# ============================================================================

# ---------------------------------------------------------------------------
# Profile: devnet | testnet
# ---------------------------------------------------------------------------
KAURAX_PROFILE=devnet

# ---------------------------------------------------------------------------
# Layer 1 — Ethereum
#   devnet : local anvil standing in for Ethereum
#   testnet: a real Ethereum testnet RPC (e.g. Sepolia)
# ---------------------------------------------------------------------------
L1_RPC_URL=http://127.0.0.1:8545
L1_WS_URL=ws://127.0.0.1:8545
L1_CHAIN_ID=8410

# ---------------------------------------------------------------------------
# Layer 2 — the underlying rollup KAURAX settles to.
#   Configurable. Not hardcoded to any particular L2.
#   devnet : local anvil standing in for the L2
#   testnet: e.g. Base Sepolia (84532), OP Sepolia (11155420), Arbitrum Sepolia (421614)
# ---------------------------------------------------------------------------
L2_RPC_URL=http://127.0.0.1:9545
L2_WS_URL=ws://127.0.0.1:9545
L2_CHAIN_ID=8415
L2_NAME=kaurax-devnet-l2
# Approximate block time of the underlying L2, seconds. Used for ETA estimates only.
L2_BLOCK_TIME=2

# ---------------------------------------------------------------------------
# Layer 3 — KAURAX
# ---------------------------------------------------------------------------
KAURAX_CHAIN_ID=8420
KAURAX_RPC_URL=http://127.0.0.1:8420
KAURAX_WS_URL=ws://127.0.0.1:8421
# Internal execution-engine endpoint. Not exposed publicly.
KAURAX_ENGINE_RPC_URL=http://127.0.0.1:18420
KAURAX_BLOCK_TIME=2
KAURAX_GAS_LIMIT=30000000
# Highest genesis block. Written by infra/scripts/devnet/start.sh; blocks at or below this
# height are genesis state and are not published through data availability.
KAURAX_GENESIS_BLOCK=0

# ---------------------------------------------------------------------------
# Settlement contracts on the L2. Populated by the deployment script.
# ---------------------------------------------------------------------------
KAURAX_PORTAL_ADDRESS=
KAURAX_OUTPUT_ORACLE_ADDRESS=
KAURAX_BATCH_INBOX_ADDRESS=
KAURAX_L2_BRIDGE_ADDRESS=

# ---------------------------------------------------------------------------
# Batcher / proposer cadence
# ---------------------------------------------------------------------------
BATCH_SUBMISSION_INTERVAL=12
BATCH_MAX_L3_BLOCKS=50
OUTPUT_PROPOSAL_INTERVAL=24
# Withdrawal challenge window, seconds. Production values are days, not seconds.
WITHDRAWAL_CHALLENGE_WINDOW=120

# ---------------------------------------------------------------------------
# Keys.
#   devnet : the public Anvil keys below are acceptable.
#   testnet: load from a KMS / hardware signer. Do NOT paste production keys here.
#            See docs/security.md.
# ---------------------------------------------------------------------------
SEQUENCER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BATCHER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
PROPOSER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- How keys are held ------------------------------------------------------
# local  : private keys above, read from this file. Devnet only.
# remote : the node never sees a key. It sends a 32-byte hash to a signing
#          service and gets a signature back. The service (services/signer, or
#          Web3Signer, or a KMS sidecar) holds the key.
#
# A testnet profile refuses to start in `local` mode with keys set, unless
# KAURAX_ALLOW_LOCAL_KEYS=true is set deliberately. See docs/key-management.md.
KAURAX_SIGNER_MODE=local
# KAURAX_SIGNER_URL=http://127.0.0.1:8555
# KAURAX_SIGNER_TOKEN=            # openssl rand -hex 32 — same value on both sides
# KAURAX_SIGNER_TIMEOUT_MS=10000
# KAURAX_ALLOW_LOCAL_KEYS=false

# Expected address per role. In remote mode the node checks the signing service
# agrees; in local mode it checks the private key derives to this. A mismatch
# stops startup rather than settling from an unexpected account.
# SEQUENCER_ADDRESS=
# BATCHER_ADDRESS=
# PROPOSER_ADDRESS=

# --- The signing service itself (services/signer) ---------------------------
# It reads SEQUENCER/BATCHER/PROPOSER_PRIVATE_KEY from ITS OWN environment,
# which must be a different environment from the node's.
# KAURAX_SIGNER_HOST=127.0.0.1    # binding anywhere else needs ALLOW_PUBLIC
# KAURAX_SIGNER_PORT=8555
# KAURAX_SIGNER_ALLOW_PUBLIC=false

# --- Durability -------------------------------------------------------------
# Blocks sealed but not yet batched, and how far deposit derivation has got.
# Both must be on persistent storage: losing the checkpoint means the node
# cannot tell whether a pending deposit was already applied.
# KAURAX_WAL_PATH=.devnet/sequencer-wal.jsonl
# KAURAX_DERIVATION_CHECKPOINT_PATH=.devnet/derivation-cursor.json
# Operator override, used only to recover from a lost checkpoint. The node
# prints the exact value to use when it needs one.
# KAURAX_DERIVATION_FROM_L2_BLOCK=

# --- Graceful shutdown (API) ------------------------------------------------
# SHUTDOWN_DRAIN_MS=3000          # fail readiness this long before closing
# SHUTDOWN_TIMEOUT_MS=25000       # hard exit if a request will not finish

# --- Backups ----------------------------------------------------------------
# BACKUP_DIR=/var/backups/kaurax
# BACKUP_RETAIN_DAYS=14

# For contract development (forge/hardhat). Leave blank and export at the shell instead.
KAURAX_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Local development settlement.
#   true  : settlement contracts live on a LOCAL L2 (anvil). Real contract calls,
#           local chain. Used by the devnet profile.
#   false : settlement contracts must exist on the configured public L2.
# ---------------------------------------------------------------------------
LOCAL_DEV_SETTLEMENT=true

# ---------------------------------------------------------------------------
# Data availability: calldata | blob | altda
#   blob and altda are configured but NOT operated in v0. See docs/data-availability.md
# ---------------------------------------------------------------------------
DA_MODE=calldata
DA_ALTDA_ENDPOINT=

# ---------------------------------------------------------------------------
# Explorer / indexer
# ---------------------------------------------------------------------------
NEXT_PUBLIC_KAURAX_RPC_URL=http://127.0.0.1:8420
NEXT_PUBLIC_KAURAX_WS_URL=ws://127.0.0.1:8421
NEXT_PUBLIC_KAURAX_CHAIN_ID=8420
NEXT_PUBLIC_L2_RPC_URL=http://127.0.0.1:9545
NEXT_PUBLIC_L1_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_EXPLORER_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PORT=7300
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database — PostgreSQL, for the indexer and application data.
#   Local dev:  postgresql://USER@127.0.0.1:5432/kaurax_dev
#   Docker:     postgresql://kaurax:PASSWORD@postgres:5432/kaurax
# The password is a real secret in any non-local deployment. Never commit it.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://kaurax:CHANGE_ME@127.0.0.1:5432/kaurax
POSTGRES_USER=kaurax
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=kaurax

# Optional cache. The API runs without it; set it to enable response caching.
REDIS_URL=

# ---------------------------------------------------------------------------
# Indexer
# ---------------------------------------------------------------------------
INDEXER_START_BLOCK=0
INDEXER_BATCH_SIZE=20
INDEXER_POLL_INTERVAL_MS=1000
# Blocks to stay behind head. 0 is correct for a single-sequencer L3.
INDEXER_CONFIRMATIONS=0
INDEXER_METRICS_PORT=7301

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated origins allowed to call the API. Never "*" in production.
API_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW="1 minute"

# ---------------------------------------------------------------------------
# KAURAX AI — xKiro gateway (https://xkiro.com)
#
# Server-side ONLY. This key must never appear in a NEXT_PUBLIC_ variable or reach a
# browser. The AI app calls the KAURAX API, which calls xKiro.
# ---------------------------------------------------------------------------
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=openai/gpt-5.6-sol

# ---------------------------------------------------------------------------
# Public URLs consumed by the frontends. Safe to expose — they contain no secrets.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_KAURAX_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_KAURAX_EXPLORER_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Server deployment (UpCloud). Only needed on the server, not for local dev.
# ---------------------------------------------------------------------------
# Root domain. Nginx serves rpc.<domain>, api.<domain>, indexer.<domain>.
KAURAX_DOMAIN=kaurax.com
# Email Let's Encrypt uses for expiry notices.
TLS_EMAIL=
# Grafana is bound to 127.0.0.1 on the server: reach it over an SSH tunnel.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ROOT_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# KAURAX application contracts, deployed onto KAURAX itself.
# Written by infra/scripts/devnet/start.sh; set manually for a testnet.
# ---------------------------------------------------------------------------
KAURAX_NAMES_ADDRESS=
KAURAX_WKAX_ADDRESS=
KAURAX_SWAP_FACTORY_ADDRESS=
KAURAX_SWAP_ROUTER_ADDRESS=
KAURAX_LAUNCHPAD_ADDRESS=

# Names pricing, per year, by label length. KAX has no monetary value, so these are
# spam resistance rather than revenue. Registration fees go to the treasury.
KAURAX_NAMES_TREASURY=
KAURAX_NAMES_PRICE_3=1000000000000000000
KAURAX_NAMES_PRICE_4=300000000000000000
KAURAX_NAMES_PRICE_5PLUS=50000000000000000
