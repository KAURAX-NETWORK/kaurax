# NOTE: processed by the nginx image's envsubst step at container start.
# Only ${KAURAX_DOMAIN} is substituted (NGINX_ENVSUBST_FILTER in docker-compose.yml);
# nginx runtime variables like $host and $remote_addr are left alone.
# Catch-all: anything arriving on an unrecognised host gets nothing useful.
#
# Without this, a request to the server's bare IP would be served by whichever server block
# happens to be first, which is how internal endpoints get discovered.
server {
    listen 80 default_server;
    server_name _;

    # Used by the container healthcheck; never proxied anywhere.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    # Let's Encrypt HTTP-01 challenge.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Reaching this server by an address that is not one of the named vhosts — most often
    # its bare IP, before DNS exists — serves the two endpoints that are public anyway.
    #
    # This does not widen what is exposed. The execution engine's admin RPC, PostgreSQL,
    # the indexer's internals and Grafana are not published to the host at all, so they are
    # unreachable from here regardless of Host header. What it avoids is a deployment that
    # answers only to a hostname nobody has pointed at it yet.
    #
    # Set KAURAX_ALLOW_IP_ACCESS=deny and re-render to restore the closed behaviour once
    # real hostnames resolve.
    location /api/ {
        proxy_pass http://kaurax_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://kaurax_rpc;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }
}
