# indexer.kaurax.com — indexer health and metrics.
#
# Read-only and low-value, but it reveals internal state, so it is restricted to private
# networks by default. Widen INDEXER_ALLOW_CIDR in the deploy configuration only if you
# genuinely want it public.
server {
    listen 80;
    server_name indexer.${KAURAX_DOMAIN};

    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }

    location / {
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;

        proxy_pass http://kaurax_indexer;
        proxy_http_version 1.1;
        proxy_set_header Host            $host;
        proxy_set_header X-Real-IP       $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection      "";
    }
}
