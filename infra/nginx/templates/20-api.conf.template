# api.kaurax.com — the KAURAX backend API.
server {
    listen 80;
    server_name api.${KAURAX_DOMAIN};

    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }

    # Health endpoints are never rate limited: deployment automation gates on them.
    location /api/health {
        proxy_pass http://kaurax_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_proto;
        proxy_set_header Connection        "";
        access_log off;
    }

    location / {
        limit_req  zone=api burst=60 nodelay;
        limit_conn conn 32;

        proxy_pass http://kaurax_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_proto;
        proxy_set_header Connection        "";

        proxy_connect_timeout 5s;
        proxy_read_timeout   65s;   # AI requests can be slow

        # CORS is enforced by the API against its own allowlist. Nginx does not add a
        # permissive header here, which would override that decision.
    }
}
