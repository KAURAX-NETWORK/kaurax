      "description": "Bridge activity into KAURAX. Deposits bypass the sequencer's mempool.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "kaurax_deposits_applied_total",
          "legendFormat": "applied",
          "refId": "A"
