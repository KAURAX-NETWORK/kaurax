      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 9,
        "x": 15,
        "y": 19
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "kaurax_last_batch_age_seconds",
          "legendFormat": "seconds since last batch",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Batch size",
      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "kaurax_last_batch_compressed_bytes",
          "legendFormat": "compressed bytes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Ethereum finality beneath the L2",
      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "description": "Absent on a local devnet, where the L1 has no consensus layer.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "kaurax_l1_finalized_block",
          "legendFormat": "finalized",
          "refId": "A"
        },
        {
          "expr": "kaurax_l1_block_height",
          "legendFormat": "head",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 400,
      "type": "row",
      "title": "RPC & bridge",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      }
    },
    {
