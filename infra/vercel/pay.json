{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile=false",
  "buildCommand": "pnpm exec turbo run build --filter=@kaurax/app-pay",
  "outputDirectory": "apps/pay/.next",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "build": {
    "env": {
      "NEXT_PUBLIC_KAURAX_DOMAIN": "kaurax.network",
      "NEXT_PUBLIC_KAURAX_CHAIN_ID": "8420",
      "NEXT_PUBLIC_KAURAX_RPC_URL": "https://kaurax.network/rpc",
      "NEXT_PUBLIC_KAURAX_API_URL": "https://kaurax.network",
      "NEXT_PUBLIC_KAURAX_EXPLORER_URL": "https://kaurax.network/explorer",
      "NEXT_PUBLIC_EXPLORER_URL": "https://kaurax.network/explorer",
      "KAURAX_UPSTREAM_ORIGIN": "http://87.58.152.42:8880"
    }
  }
}
