# ── Build output and dependencies ────────────────────────────────────────────
node_modules/
dist/
.next/
out/
*.tsbuildinfo
.turbo/
coverage/
*.tar.zst
.vercel/
.vercel

# ── Secrets ──────────────────────────────────────────────────────────────────
# Order matters: git applies the LAST matching pattern, so the negation for the
# example file has to come after every rule that would otherwise catch it.
.env
.env.*
*.key
*.pem
*.p12
*.pfx
keystore/
mnemonic.txt
*.mnemonic

# CLI wallet keyfiles. Encrypted, but a passphrase is only as strong as the number
# of people who can attempt it offline — and KAURAX_HOME can point inside the repo.
keys.json
.kaurax/

# SSH material, in case a deploy key is generated in the working tree.
id_rsa
id_dsa
id_ecdsa
id_ed25519
*_rsa
*_ed25519
known_hosts

!.env.example

# ── Devnet runtime state (regenerated by infra/scripts/devnet/start.sh) ──────
.devnet/
*.log
*.pid

# ── Foundry ─────────────────────────────────────────────────────────────────
blockchain/contracts/out/
blockchain/contracts/cache/
blockchain/contracts/broadcast/
blockchain/contracts/lib/

# ── Generated ───────────────────────────────────────────────────────────────
# Rebuilt from the repository's markdown by apps/docs/scripts/collect-docs.mjs
apps/docs/lib/docs-content.ts

.DS_Store

# Foundry build output from the standalone example project
examples/basic-contract/out/
examples/basic-contract/cache/

.reproduce/
