    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
