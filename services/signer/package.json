{
  "name": "@kaurax/signer",
  "version": "0.1.0",
  "private": true,
  "description": "KAURAX reference signing service \u2014 holds operator keys so the node does not",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "kaurax-signer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
