{
  "name": "@kaurax/ui",
  "version": "0.1.0",
  "description": "Shared KAURAX design system and React components",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": "./src/index.tsx",
    "./styles.css": "./src/styles.css"
  },
  "files": ["src"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"@kaurax/ui is presentational; behaviour is covered by the apps that use it\"",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {"react": "^19.0.0", "react-dom": "^19.0.0"},
  "dependencies": {"@kaurax/types": "workspace:*"},
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
